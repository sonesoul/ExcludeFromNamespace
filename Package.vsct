  <Extern href="stdidcmd.h"/>

  <Extern href="vsshlids.h"/>

  <Commands package="guidPackage">
	  
    <Groups>
      <Group guid="guidPackageCmdSet" id="MyMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS"/>
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidPackageCmdSet" id="cmdidToolWindow1Command" priority="0x0100" type="Button">
        <Parent guid="guidPackageCmdSet" id="MyMenuGroup" />
        <Strings>
          <ButtonText>Exclude From Namespace</ButtonText>
        </Strings>
      </Button>
    </Buttons>

    <Bitmaps>
      <Bitmap guid="guidImages1" href="Resources\ToolWindow1Command.png" usedList="bmpPic1, bmpPic2, bmpPicSearch, bmpPicX, bmpPicArrows, bmpPicStrikethrough" />
    </Bitmaps>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidPackage" value="{6efff7ff-fae2-4b54-b1d6-22a6221eeb3a}" />

    <GuidSymbol name="guidPackageCmdSet" value="{1622adfe-f37f-40e5-b168-f808d3885f9f}">
      <IDSymbol name="MyMenuGroup" value="0x1020" />
      <IDSymbol name="Command1Id" value="0x0100" />
      <IDSymbol value="4129" name="cmdidToolWindow1Command"/>
    </GuidSymbol>

    <GuidSymbol name="guidImages" value="{2ae7133b-3fdf-4025-b9e7-0a861cfb4b0d}">
      <IDSymbol name="bmpPic1" value="1" />
      <IDSymbol name="bmpPic2" value="2" />
